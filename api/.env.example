# ==============================================================================
# MyVPR API Environment Configuration Template
# ==============================================================================
# Copy this file to .env inside the api/ directory:
#   cp api/.env.example api/.env
# Fill in your values. NEVER commit .env to Git.
# ==============================================================================

# ── Environment & Application ─────────────────────────────────────────────────
# 'development' enables detailed debugging; 'production' enables error logging to files.
APP_ENV=development
AUTO_MIGRATE=false

# ── Database Connection (MySQL / MariaDB) ─────────────────────────────────────
DB_HOST=localhost
DB_NAME=virtual_praise_room
DB_USER=vpr_user
DB_PASS=your_secure_password_here
DB_PORT=3306

# ── Frontend SPA URL ──────────────────────────────────────────────────────────
# Used for CORS whitelist and post-auth / post-payment redirects.
# Development: http://localhost:5173
# Production:  https://myvpr.org
REACT_APP_URL=http://localhost:5173

# ── KingsChat OAuth 2.0 Credentials ───────────────────────────────────────────
# Obtain from the KingsChat Developer Portal: https://developer.kingschat.online
KINGSCHAT_CLIENT_ID=YOUR_KINGSCHAT_CLIENT_ID
KINGSCHAT_CLIENT_SECRET=YOUR_KINGSCHAT_CLIENT_SECRET
KINGSCHAT_API_KEY=YOUR_KINGSCHAT_API_KEY
# Exact redirect URL registered in your KingsChat app settings:
# Development: http://localhost:8000/api/auth/kingschat/callback
# Production:  https://myvpr.org/api/auth/kingschat/callback
KINGSCHAT_REDIRECT_URI=http://localhost:8000/api/auth/kingschat/callback

# ── Squad Payment Gateway (HabariPay / GTCO) ─────────────────────────────────
# Dashboard: https://dashboard.squadco.com (Profile -> API & Webhook)
# SQUAD_ENV: 'sandbox' for testing, 'production' for live processing
SQUAD_ENV=sandbox
SQUAD_SECRET_KEY=sandbox_sk_your_secret_key_here
SQUAD_PUBLIC_KEY=sandbox_pk_your_public_key_here
SQUAD_WEBHOOK_SECRET=sandbox_sk_your_secret_key_here
# Set to 'true' in production to restrict webhook callbacks to Squad IP: 18.133.63.109
SQUAD_ENFORCE_IP_WHITELIST=false

# ── Amazon Web Services (AWS IVS & S3) ────────────────────────────────────────
# Used for AWS Interactive Video Service (IVS) low-latency channel provisioning
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET=myvpr-recordings
AWS_CLOUDFRONT_URL=https://d12345abcdef.cloudfront.net

# ── Email Service (Brevo / Sendinblue) ────────────────────────────────────────
# Used for password reset emails, salvation follow-ups, and notifications
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=info@myvpr.org
BREVO_SENDER_NAME="Virtual Praise Room"

# ── Daily.co Video Room API ──────────────────────────────────────────────────
# Used for multi-participant praise meetings and group video watch sessions
DAILY_API_KEY=your_daily_co_api_key_here
DAILY_ROOM_DURATION=86400

# ── Espees Cryptocurrency / Merchant Payments ────────────────────────────────
# Used for Espees wallet donations, offerings, and gift subscriptions
ESPEES_API_KEY=esp_your_espees_api_key_here
ESPEES_MERCHANT_WALLET=LMM01
ESPEES_MERCHANT_NAME="Virtual Praise Room"
