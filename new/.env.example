# ==============================================================================
# MyVPR Frontend (Vite + React) Environment Configuration Template
# ==============================================================================
# Copy this file to .env in the new/ directory if custom overrides are needed:
#   cp new/.env.example new/.env
# In standard local development, the Vite proxy forwards all /api requests
# directly to http://localhost:8000/api automatically.
# ==============================================================================

# Backend API Base URL (leave empty or /api to use relative Vite proxy)
VITE_API_BASE_URL=/api

# Production Platform Hostname
VITE_APP_URL=https://myvpr.org
