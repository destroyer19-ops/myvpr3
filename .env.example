# ==============================================================================
# MyVPR Root Environment Configuration Template
# ==============================================================================
# Copy this file to .env at the root directory:
#   cp .env.example .env
# Fill in your values. NEVER commit .env to Git.
# ==============================================================================

# Database Credentials
DB_HOST=localhost
DB_NAME=virtual_praise_room
DB_USER=vpr_user
DB_PASS=your_secure_password_here
DB_PORT=3306

# Application Environment
APP_ENV=development
APP_DEBUG=true

# Server URLs
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Third-party Integrations (referenced by legacy PHP scripts and CLI runners)
BREVO_API_KEY=your_brevo_api_key
DAILY_API_KEY=your_daily_api_key
KINGSCHAT_CLIENT_ID=your_kingschat_client_id
ESPEES_API_KEY=your_espees_api_key
